__pycache__/
*.pyc
_tmp_batches/
.DS_Store

# Byte-identical to the published index.html, so only that one is versioned.
# Kept on disk as the familiar double-click filename.
PedEndoLit-Dashboard.html

# Guideline sweep working files — regenerated each month from sweep_raw.json.
# guideline_decisions.json IS versioned (it's the memory of what was ruled on).
guideline_review.html
guideline_approved_raw.json

# Classifier QA sweep — same pattern. classifier_qa_sample.json, _verdicts.json,
# _report.md, and _decisions.json (the ledger) ARE versioned as the audit trail of
# each round; only the review HTML is regenerated and ignored.
classifier_qa_review.html

# Round-N copies of the review page: 1.2 MB each and fully regenerable from
# classifier_qa_sample.round*.json + classifier_qa_verdicts.round*.json, which ARE
# versioned. The repo already carries a size problem (see DECISIONS.md).
classifier_qa_review.round*.html
